{
  "incopat": {
    "lineWidth": 120,
    "indentWidth": 2,
    "useTabs": false,
    "fieldCase": "lowercase",
    "booleanOperatorCase": "lowercase",
    "quoteStyle": "double",
    "operatorPosition": "before"
  },
  "includes": [
    "**/*.incopat"
  ],
  "excludes": [
    "target"
  ],
  "plugins": [
    "https://github.com/CNIPA/dprint-plugin-incopat/releases/download/v0.2.8/dprint_plugin_incopat.wasm"
  ]
}
